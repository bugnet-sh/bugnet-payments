# Secrets only, every other setting lives in config/*.toml.
# Copy to .env (chmod 600). Never commit .env.

# Shared secret the gateway sends as "Authorization: Bearer <token>" to the internal API.
# At least 32 characters, e.g. openssl rand -base64 32.
BUGNET_PAYMENTS_TOKEN=
# Payments' own caller token for the router (CheckPayer, GetOrder, LookupPlacement, event appends); not the gateway's token.
# At least 32 characters while router.get_order or router.check_payer is on, or [x402] allowance_wallet is set.
BUGNET_PAYMENTS_ROUTER_TOKEN=
# Ed25519 seed that signs router order tokens (router holds only the public key).
BUGNET_ORDER_PRIVATE_KEY=
# 32-byte key (base64) that seals an unpaid order's claim so an idempotent create can return it.
BUGNET_CLAIM_KEY=
# Fee payer: SOL only; co-signs and pays network fees for every settlement and refund (base58 64-byte secret).
BUGNET_FEE_PAYER_KEY=
# Refund wallet: hot, small USDC float; sends refunds back to payers (base58 64-byte secret).
BUGNET_REFUND_KEY=
# Hot allowance wallet: USDC only, pays x402 sellers (base58 64-byte secret); needed once [x402] allowance_wallet is set.
BUGNET_ALLOWANCE_KEY=
# The x402 signer listener's TLS private key, base64 of the PEM from bugnet-dev mtls init.
BUGNET_X402_TLS_KEY=
# Solana mainnet RPC endpoints in priority order, comma-separated, no spaces or quotes:
# <primary URL>,<first fallback URL>,<last fallback URL>. The first serves while it is healthy.
# Wins over BUGNET_SOLANA_RPC_URL when both are set. A comma inside a URL is %2C.
BUGNET_SOLANA_RPC_URLS=
# One Solana mainnet RPC URL, read only while BUGNET_SOLANA_RPC_URLS is unset or blank.
BUGNET_SOLANA_RPC_URL=

# --- Test only -------------------------------------------------------------------------------
# Test payer secret key (base58 or JSON byte array); used when non-empty.
BUGNET_TEST_PAYER_KEY=
# Test payer BIP39 recovery phrase (words separated by spaces); used when the key above is empty.
BUGNET_TEST_PAYER_MNEMONIC=
# Phantom account number inside that phrase, path m/44'/501'/i'/0' (default 0).
BUGNET_TEST_PAYER_ACCOUNT_INDEX=0
# TEST ONLY; production recipient is cold (its key never sits on the server).
BUGNET_RECIPIENT_KEY=
# Postgres URL for database tests, e.g. postgres://localhost:5432/postgres?sslmode=disable
BUGNET_TEST_PG_URL=
