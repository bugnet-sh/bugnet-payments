# Runs bugnet-payments-backup.service every night (spec 23.2); Persistent catches up a run missed
# while the server was down
[Unit]
Description=Bugnet Payments database backup, every night

[Timer]
OnCalendar=*-*-* 02:15:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
